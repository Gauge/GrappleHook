<Project>

  <!--
    Shared settings for the isolated test environment.

    The only Space Engineers assembly these projects reference is VRage.Math.dll, which is
    pure managed math (Vector3D, MatrixD, RayD, BoundingBoxD) and loads fine on .NET on
    Linux. Everything else is plain C#.

    Resolution order for that DLL:
      1. $(SEBinPath) passed on the command line, or the SE_BIN environment variable
      2. binarypath in ../GrappleHook/mdk.local.ini, the same file MDK2 reads
      3. the default Steam install paths

    Core deliberately references VRage.Math alone, rather than every game assembly the way
    Mal.Mdk2.References would: a game type used in Core then fails to compile here instead of
    compiling and failing at test time.
  -->

  <PropertyGroup>
    <SEBinPath Condition="'$(SEBinPath)' == '' And '$(SE_BIN)' != ''">$(SE_BIN)</SEBinPath>
    <MdkLocalIni>$(MSBuildThisFileDirectory)../GrappleHook/mdk.local.ini</MdkLocalIni>
    <MdkLocalBinaryPath Condition="Exists('$(MdkLocalIni)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MdkLocalIni)')), '(?m)^\s*binarypath\s*=\s*(.+?)\s*$').Groups[1].Value)</MdkLocalBinaryPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And '$(MdkLocalBinaryPath)' != '' And Exists('$(MdkLocalBinaryPath)/VRage.Math.dll')">$(MdkLocalBinaryPath)</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- referencing a net472 assembly from net9.0 is intentional here -->
    <NoWarn>$(NoWarn);MSB3277;NU1701;CS1591</NoWarn>
    <CoreSourceRoot>$(MSBuildThisFileDirectory)../GrappleHook/Core/</CoreSourceRoot>
  </PropertyGroup>

  <Target Name="VerifySEBinPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SEBinPath)' == ''">
    <Error Text="Could not locate VRage.Math.dll. Set binarypath in GrappleHook/mdk.local.ini, or SE_BIN, to your Space Engineers Bin64 folder, e.g. SE_BIN=/path/to/SpaceEngineers/Bin64 dotnet test" />
  </Target>

</Project>
